{
  "name": "rom-polybot",
  "productName": "ROM PolyBot",
  "version": "2.12.0",
  "description": "ROM Polybot desktop trading application for Polymarket US",
  "main": "dist-electron/main.js",
  "author": "ROM",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node scripts/setup-python.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "py:setup": "node scripts/setup-python.mjs",
    "py:test": "node scripts/test-python.mjs",
    "py:backtest": "node scripts/backtest.mjs",
    "py:backtest15m": "node scripts/backtest.mjs --c15",
    "py:volume": "node scripts/volume-farm.mjs",
    "test:e2e": "npm run build && node e2e/arming.e2e.mjs",
    "py:dist": "node scripts/build-python.mjs",
    "dist": "npm run build && npm run py:dist && electron-builder"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@types/discord-rpc": "^4.0.9",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "codemirror": "^6.0.2",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.49.0",
    "lucide-react": "^0.368.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.9",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "app.rom.polybot",
    "productName": "ROM PolyBot",
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "python/dist/rom-polybot-backend",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/discord-rpc/**",
      "resources/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/rom.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "ROM",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 350,
          "type": "file",
          "path": "build/HOW TO USE.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "runAfterFinish": true,
      "installerIcon": "resources/rom.ico",
      "uninstallerIcon": "resources/rom.ico",
      "uninstallDisplayName": "ROM PolyBot",
      "include": "build/installer.nsh",
      "shortcutName": "ROM PolyBot"
    },
    "publish": null
  }
}
